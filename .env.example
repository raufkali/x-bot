# ============================================================
# X_BOT — Environment Configuration
# ============================================================

# ------------------------------------------------------------
# AI ENGINE SETTINGS
# ------------------------------------------------------------
# Option 1: Free Groq Cloud API (Recommended — Free, Fast, No Cost)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=

# Option 2: Paid xAI Grok API
# Get an API key at: https://console.x.ai
GROK_API_KEY=

# Model selection (Optional, defaults to best model per provider)
# For Groq: llama-3.3-70b-versatile
# For xAI: grok-beta or grok-2
AI_MODEL=

# ------------------------------------------------------------
# META WHATSAPP CLOUD API (For Owner Approvals)
# ------------------------------------------------------------
# Meta App ID
WHATSAPP_APP_ID=1538340228340646

# Temporary or System User Access Token from developers.facebook.com
WHATSAPP_TOKEN=

# Phone Number ID provided in Meta WhatsApp API Setup
WHATSAPP_PHONE_NUMBER_ID=1412689751934980

# WhatsApp Business Account ID (WABA ID)
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Your Personal WhatsApp Phone Number to receive approval requests
# Country code without + (e.g., 923435022880 for Pakistan, 15551234567 for USA)
OWNER_PHONE_NUMBER=

# Meta Graph API Version (defaults to v25.0)
GRAPH_API_VERSION=v25.0

# Pre-approved Template Name and Language
WHATSAPP_TEMPLATE_NAME=3p_direct_integration_test_template
WHATSAPP_TEMPLATE_LANG=en_US

# Secret string used by Meta to verify your webhook
WEBHOOK_VERIFY_TOKEN=xbot_verify_token_2026

# Webhook server port
PORT=3000

# ------------------------------------------------------------
# AUTOMATED POST SCHEDULER (9:00 AM, 2:00 PM, 8:00 PM)
# ------------------------------------------------------------
# Time of day to automatically generate and send post (24-hour HH:MM format)
POST_SCHEDULE_TIME=09:00
POST_SCHEDULE_TIMES=09:00,14:00,20:00

# Timezone for the daily schedule (e.g. Asia/Karachi, UTC, America/New_York)
SCHEDULE_TIMEZONE=Asia/Karachi
SCHEDULE_ENABLED=true

# ------------------------------------------------------------
# MONGODB ATLAS DATABASE (Deduplication & Post Storage)
# ------------------------------------------------------------
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.jsxyhxh.mongodb.net/x_bot?retryWrites=true&w=majority


# Enable/disable auto-scheduling (true / false)
SCHEDULE_ENABLED=true
