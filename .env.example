# ============================================================
# X_BOT — Environment Configuration
# ============================================================

# OPTION 1: Free Groq Cloud API (Recommended — Free, Fast, No Cost)
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=

# OPTION 2: Paid xAI Grok API
# Get an API key at: https://console.x.ai
GROK_API_KEY=

# Model selection (Optional, defaults to best model per provider)
# For Groq: llama-3.3-70b-versatile
# For xAI: grok-beta or grok-2
AI_MODEL=
