# ============================================================
# X_BOT — Environment Configuration
# ============================================================

# AI Provider Mode: "auto" (attempt browser automation first, fallback to manual) or "manual"
GROK_MODE=auto

# Grok Chat Website URL
GROK_URL=https://grok.com

# Browser Automation Settings (Playwright)
# Connect to an existing authenticated Chrome instance via CDP (e.g. google-chrome --remote-debugging-port=9222)
CHROME_CDP_URL=

# Or specify a custom browser executable path:
BROWSER_EXECUTABLE_PATH=

# Run browser in headless mode (true/false)
BROWSER_HEADLESS=true

# Browser timeout in milliseconds
BROWSER_TIMEOUT_MS=45000

# Default preferences
DEFAULT_TONE=Informative
DEFAULT_AUDIENCE=General Public
