# Server & Runtime
PORT=3000
RENDER=
RENDER_EXTERNAL_URL=
KEEP_ALIVE_URL=

# AI Providers (Configure one or more; falls back to built-in analytical bank if unset)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROK_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
AI_MODEL=

# Grok Browser Automation (Optional CLI mode)
GROK_MODE=auto
GROK_URL=https://grok.com
CHROME_CDP_URL=
BROWSER_EXECUTABLE_PATH=
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=45000

# Default Generation Settings
DEFAULT_TONE=Informative
DEFAULT_AUDIENCE=General Public

# Database (Optional — runs with in-memory + local JSON fallback when unset)
MONGODB_URI=

# Meta WhatsApp Cloud API (Optional — for WhatsApp approval workflow)
WHATSAPP_APP_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
OWNER_PHONE_NUMBER=
OWNER_PHONE_NUMBERS=
WEBHOOK_VERIFY_TOKEN=xbot_verify_token_2026
GRAPH_API_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=3p_direct_integration_test_template
WHATSAPP_TEMPLATE_LANG=en_US

# Automated Scheduler
POST_SCHEDULE_TIME=09:00
POST_SCHEDULE_TIMES=09:00,14:00,20:00
SCHEDULE_TIMEZONE=Asia/Kolkata
SCHEDULE_ENABLED=true

# X (Twitter) OAuth 2.0 & API
X_API_KEY=
X_API_SECRET=
X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CALLBACK_URL=http://localhost:3000/auth/x/callback
